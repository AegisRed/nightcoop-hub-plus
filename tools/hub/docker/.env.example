# NightCoop hub — settings for docker compose (copy to .env next to docker-compose.yml)

# Entry UDP port. Threads of the hub listen on PORT+10, PORT+11, … (47810, 47811, … by default) — open them too
NIGHTCOOP_PORT=47800
# Threads = CPU cores you give the hub ("auto" — every core of the server). Each thread serves up to MAX_CLIENTS connections
NIGHTCOOP_SHARDS=auto
# Connections per thread: every player keeps one to the hub for the whole session
NIGHTCOOP_MAX_CLIENTS=512
# Name and region in the hub's own certificate (shown in players' logs; the fingerprint is what protects them)
NIGHTCOOP_HUB_NAME=hub.example.org
NIGHTCOOP_REGION=eu
# Anything else for nightcoop_hub (for example --cookie always, --max-guests 16)
NIGHTCOOP_EXTRA_ARGS=
# A ready image instead of building one (only if you trust its publisher)
# NIGHTCOOP_IMAGE=nightcoop-hub:local
